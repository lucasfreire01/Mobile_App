# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Runtime database role only. See docs/database-runtime-role.md for provisioning.
# PostgreSQL bootstrap/migration credentials belong in .env.database-admin.
DB_CONNECTION=pg
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=saganexus_runtime
DB_PASSWORD=
DB_DATABASE=browan_config

# Browan SSH (the private key stays only on the backend host)
BROWAN_SSH_KEY_PATH=/absolute/path/to/browan_config
BROWAN_SSH_USERNAME=root
BROWAN_SSH_PORT=22

# SSH status monitoring: one database lease owner across replicas; limits apply to that owner.
GATEWAY_MONITOR_CONCURRENCY=5
GATEWAY_MONITOR_BATCH_SIZE=50
GATEWAY_MONITOR_TIMEOUT_MS=15000
GATEWAY_MONITOR_CYCLE_TIMEOUT_MS=100000

# Development administrator seed
SEED_ADMIN_EMAIL=admin@browan.local
SEED_ADMIN_PASSWORD=

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Select a provider registered in config/vpn.ts. Existing gateways keep their original provider.
VPN_PROVIDER=cloudconnexa
# Required only when using the CloudConnexa adapter (including gateways already bound to it).
CLOUDCONNEXA_BASE_URL=https://YOUR_TENANT.api.openvpn.com
CLOUDCONNEXA_CLIENT_ID=
CLOUDCONNEXA_CLIENT_SECRET=
CLOUDCONNEXA_REGION=br-gru
CLOUDCONNEXA_ACCESS_GROUP_ID=
GATEWAY_MGMT_IP_PREFIX=10.200.0

# Queue monitoring: mark queue health as degraded after this pending age
QUEUE_HEALTH_MAX_PENDING_AGE_SECONDS=300
# Worker runs every 10 seconds; allow enough time for normal scheduling jitter.
QUEUE_HEALTH_MAX_WORKER_AGE_SECONDS=60
# Mark the queue as degraded after a recent SSH host key mismatch.
QUEUE_HEALTH_HOST_KEY_MISMATCH_WINDOW_SECONDS=900
LIMITER_STORE=database

# Optional SSH destination ranges, comma separated. Defaults to the management
# prefix /24. Add a specific LAN subnet here before applying a static LAN IP.
# GATEWAY_SSH_ALLOWED_CIDRS=10.200.0.0/24,192.168.11.0/24
